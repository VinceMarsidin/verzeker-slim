// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Verzekering {
  id            Int     @id @default(autoincrement())
  categorie     String  // motor, reis, woon, leven
  dekking_naam  String
  assuria       String
  fatum         String
  self_reliance String
  parsasco      String
}